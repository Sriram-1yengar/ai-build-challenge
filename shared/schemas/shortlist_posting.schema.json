{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShortlistPosting",
  "description": "Output of Phase 4, input to Phase 5. Mirrors detailed-build-plan.md §0.3. EXTENSIONS pending team sign-off: benefits, shift, match_score, match_reasons, pay_comparison, missing_fields, warnings, questions_to_ask. `location` and `contact_method` are nullable here (§0 typed them non-null) so a phase never has to invent a value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "posting_id",
    "title",
    "employer",
    "location",
    "pay",
    "requirements",
    "benefits",
    "shift",
    "contact_method",
    "source_url",
    "summary",
    "match_score",
    "match_reasons",
    "pay_comparison",
    "missing_fields",
    "warnings",
    "questions_to_ask"
  ],
  "properties": {
    "posting_id": { "type": "string" },
    "title": { "type": "string" },
    "employer": { "type": ["string", "null"] },
    "location": { "type": ["string", "null"] },
    "pay": { "type": ["string", "null"] },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "benefits": { "type": "array", "items": { "type": "string" } },
    "shift": { "enum": ["day", "night", "rotational", "flexible", null] },
    "contact_method": { "type": ["string", "null"] },
    "source_url": { "type": "string", "format": "uri" },
    "summary": { "type": "string" },
    "match_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "match_reasons": { "type": "array", "items": { "type": "string" } },
    "pay_comparison": { "enum": ["above_market", "near_market", "below_market", "unknown"] },
    "missing_fields": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "questions_to_ask": { "type": "array", "items": { "type": "string" } }
  }
}
