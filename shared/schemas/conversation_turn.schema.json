{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConversationTurn",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "text", "referenced_posting_ids"],
  "properties": {
    "role": { "enum": ["applicant", "agent"] },
    "text": { "type": "string" },
    "referenced_posting_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

